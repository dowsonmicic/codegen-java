[
  {
    "resource": "Author",
    "basePath": "/bookshop/author",
    "packageName": "com.dowson.testdemo",
    "tag": "Bookshop-Author",
    "description": "作者管理",
    "entity": "Author",
    "mapper": "AuthorMapper",
    "useMpService": true,
    "operations": [
      {
        "name": "create",
        "method": "POST",
        "path": "/create",
        "summary": "创建作者",
        "permission": "bookshop:author:create",
        "transactional": true,
        "requestDto": "AuthorCreateReq",
        "responseVo": "AuthorRespVO"
      },
      {
        "name": "update",
        "method": "PUT",
        "path": "/update",
        "summary": "更新作者",
        "permission": "bookshop:author:update",
        "transactional": true,
        "requestDto": "AuthorUpdateReq"
      },
      {
        "name": "delete",
        "method": "DELETE",
        "path": "/delete",
        "summary": "删除作者",
        "permission": "bookshop:author:delete",
        "transactional": true,
        "requestDto": "AuthorDeleteReq"
      },
      {
        "name": "get",
        "method": "GET",
        "path": "/get",
        "summary": "查询作者详情",
        "permission": "bookshop:author:query",
        "responseVo": "AuthorRespVO"
      },
      {
        "name": "page",
        "method": "GET",
        "path": "/page",
        "summary": "分页查询作者",
        "permission": "bookshop:author:query",
        "responseVo": "AuthorPageVO"
      }
    ]
  },
